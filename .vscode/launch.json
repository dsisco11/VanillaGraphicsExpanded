{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Client",
            "type": "coreclr",
            "request": "launch",
            "program": "${config:vanillaGraphicsExpanded.renderdocPath}/renderdoccmd.exe",
            "preLaunchTask": "build + tail (RenderDoc)",
            "postDebugTask": "stop + scan: VintageStory client-debug.log",
            "env": {
                "VGE_DATA_PATH": "${config:vanillaGraphicsExpanded.dataPath}"
            },
            "args": [
                "capture",
                "--wait-for-exit",
                "${env:VINTAGE_STORY}/Vintagestory.exe",
                "--openWorld", "TestWorld",
                "--tracelog",
                "--dataPath",
                "${config:vanillaGraphicsExpanded.dataPath}",
                "--addModPath",
                "${workspaceFolder}/VanillaGraphicsExpanded/bin/Debug/Mods",
                "--addOrigin",
                "${workspaceFolder}/VanillaGraphicsExpanded/assets"
            ],
            "cwd": "${env:VINTAGE_STORY}",
            "console": "internalConsole",
            "internalConsoleOptions": "neverOpen",
            "stopAtEntry": false
        },
        {
            "name": "Launch Client (CPU Profile)",
            "type": "coreclr",
            "request": "launch",
            "program": "C:/Program Files/PowerShell/7/pwsh.exe",
            "preLaunchTask": "Build (dotnet)",
            "env": {
                "VGE_DATA_PATH": "${config:vanillaGraphicsExpanded.dataPath}"
            },
            "args": [
                "-NoProfile",
                "-File", "${workspaceFolder}/tools/Start-ClientCpuProfile.ps1",
                "-WorkspaceRoot", "${workspaceFolder}",
                "-GameRoot", "${env:VINTAGE_STORY}",
                "-DataPath", "${config:vanillaGraphicsExpanded.dataPath}"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Launch Server",
            "type": "coreclr",
            "request": "launch",
            "program": "${env:VINTAGE_STORY}/VintagestoryServer.exe",
            "linux": {
                "program": "${env:VINTAGE_STORY}/VintagestoryServer"
            },
            "osx": {
                "program": "${env:VINTAGE_STORY}/VintagestoryServer"
            },
            "preLaunchTask": "Build (dotnet)",
            "env": {
                "VGE_DATA_PATH": "${config:vanillaGraphicsExpanded.dataPath}"
            },
            "args": [
                "--tracelog",
                "--dataPath",
                "${config:vanillaGraphicsExpanded.dataPath}",
                "--addModPath",
                "${workspaceFolder}/VanillaGraphicsExpanded/bin/Debug/Mods",
                 "--addOrigin",
                 "${workspaceFolder}/VanillaGraphicsExpanded/assets"
            ],
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "CakeBuild",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Build (Cake)",
            "program": "${workspaceFolder}/CakeBuild/bin/Debug/net7.0/CakeBuild.dll",
            "args": [],
            "cwd": "${workspaceFolder}/CakeBuild",
            "stopAtEntry": false,
            "console": "internalConsole"
        }
    ]
}
