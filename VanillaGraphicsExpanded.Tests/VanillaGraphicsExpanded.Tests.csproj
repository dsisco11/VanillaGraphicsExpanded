<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableSpirv Condition="'$(EnableSpirv)' == ''">true</EnableSpirv>
    <SpirvArtifactsDir Condition="'$(SpirvArtifactsDir)' == ''">$(MSBuildProjectDirectory)\..\VanillaGraphicsExpanded\artifacts\spirv</SpirvArtifactsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit.v3" Version="1.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.0" />
    <!-- OpenTK packages for GPU testing (includes native GLFW binaries) -->
    <PackageReference Include="OpenTK" Version="4.9.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VanillaGraphicsExpanded\VanillaGraphicsExpanded.csproj" />
    <!-- Exercise the production source-layout emitter directly. -->
    <Compile Include="..\ShaderBuildTool\Spirv\ShaderSourceLayout.cs" Link="ShaderBuildTool\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Reference VintagestoryAPI from game directory -->
  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(VINTAGE_STORY)/VintagestoryLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- Runtime shader lifecycle code uses the same Harmony assembly supplied by the game. -->
    <Reference Include="0Harmony">
      <HintPath>$(VINTAGE_STORY)/Lib/0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- IRenderAPI proxy fixtures need its public signature types, without invoking native drawing. -->
    <Reference Include="SkiaSharp">
      <HintPath>$(VINTAGE_STORY)/Lib/SkiaSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Copy shader assets to test output directory for GPU tests -->
  <ItemGroup>
    <Content Include="..\VanillaGraphicsExpanded\assets\vanillagraphicsexpanded\shaders\**\*">
      <Link>assets\shaders\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="..\VanillaGraphicsExpanded\assets\vanillagraphicsexpanded\shaderincludes\**\*">
      <Link>assets\shaderincludes\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Tests exercise the compiled assets. Disabling their producer must fail rather than reuse old binaries. -->
  <Target Name="RequireTestSpirvBuild" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(EnableSpirv)' != 'true'" Text="GPU tests require EnableSpirv=true. Build shader assets before running tests." />
  </Target>

  <!-- Enumerate after project references build, so a clean build includes newly generated binaries. -->
  <Target Name="CopyTestSpirvAssets" AfterTargets="Build">
    <ItemGroup>
      <_TestSpirvFiles Include="$(SpirvArtifactsDir)\vanillagraphicsexpanded\shaders\**\*.spv" />
      <_RequiredTestSpirv Include="..\VanillaGraphicsExpanded\assets\vanillagraphicsexpanded\shaders\*.csh" />
    </ItemGroup>
    <Error Condition="!Exists('$(SpirvArtifactsDir)\vanillagraphicsexpanded\shaders\%(_RequiredTestSpirv.Filename)%(_RequiredTestSpirv.Extension).spv')"
           Text="Missing compiled test shader: %(_RequiredTestSpirv.Filename)%(_RequiredTestSpirv.Extension).spv" />
    <Copy SourceFiles="@(_TestSpirvFiles)" DestinationFiles="@(_TestSpirvFiles->'$(TargetDir)assets\shaders\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
