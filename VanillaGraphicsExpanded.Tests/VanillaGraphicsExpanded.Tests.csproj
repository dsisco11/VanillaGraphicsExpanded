<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableSpirv Condition="'$(EnableSpirv)' == ''">true</EnableSpirv>
    <SpirvArtifactsDir Condition="'$(SpirvArtifactsDir)' == ''">$(MSBuildProjectDirectory)\..\artifacts\spirv\$(Configuration)</SpirvArtifactsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit.v3" Version="1.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.0" />
    <!-- OpenTK packages for GPU testing (includes native GLFW binaries) -->
    <PackageReference Include="OpenTK" Version="4.9.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VanillaGraphicsExpanded\VanillaGraphicsExpanded.csproj" />
    <Compile Include="..\ShaderBuildTool\TestShaderPrograms.cs" Link="Fixtures\Shaders\TestShaderPrograms.cs" />
    <!-- Exercise the production source-layout emitter directly. -->
    <Compile Include="..\ShaderBuildTool\Spirv\ShaderSourceLayout.cs" Link="ShaderBuildTool\%(Filename)%(Extension)" />
    <Compile Include="..\ShaderBuildTool\Spirv\ShaderVariantSource.cs;..\ShaderBuildTool\Spirv\ShaderSourcePreprocessor.cs;..\ShaderBuildTool\Spirv\DerivedGlobalConstants.cs;..\ShaderBuildTool\Spirv\FileSystemSyntaxTreeResourceResolver.cs" Link="ShaderBuildTool\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Reference VintagestoryAPI from game directory -->
  <ItemGroup>
    <!-- Moq inspects engine BlockPos serialization attributes when building typed accessor setups. -->
    <Reference Include="protobuf-net">
      <HintPath>$(VINTAGE_STORY)/Lib/protobuf-net.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(VINTAGE_STORY)/VintagestoryLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(VINTAGE_STORY)/Mods/VSEssentials.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- Runtime shader lifecycle code uses the same Harmony assembly supplied by the game. -->
    <Reference Include="0Harmony">
      <HintPath>$(VINTAGE_STORY)/Lib/0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- IRenderAPI proxy fixtures need its public signature types, without invoking native drawing. -->
    <Reference Include="SkiaSharp">
      <HintPath>$(VINTAGE_STORY)/Lib/SkiaSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />

  </ItemGroup>

  <!-- Test assets overlay production inputs; one catalog publishes a complete digest manifest. -->
  <Target Name="BuildTestShaderFixtures" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <TestShaderArtifacts>$(MSBuildProjectDirectory)\..\artifacts\spirv-tests\$(Configuration)</TestShaderArtifacts>
      <TestShaderInputs>$(MSBuildProjectDirectory)\obj\$(Configuration)\test-shader-inputs</TestShaderInputs>
    </PropertyGroup>
    <RemoveDir Directories="$(TestShaderInputs)" />
    <ItemGroup>
      <_ProductionShaderInput Include="..\VanillaGraphicsExpanded\assets\vanillagraphicsexpanded\**\*" />
      <_FixtureShaderInput Include="Fixtures\Shaders\assets\vanillagraphicsexpanded\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ProductionShaderInput)" DestinationFiles="@(_ProductionShaderInput->'$(TestShaderInputs)\vanillagraphicsexpanded\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(_FixtureShaderInput)" DestinationFiles="@(_FixtureShaderInput->'$(TestShaderInputs)\vanillagraphicsexpanded\%(RecursiveDir)%(Filename)%(Extension)')" />
    <MSBuild Projects="..\SpirvBuild\VanillaGraphicsExpanded.SpirvBuild.csproj"
             Targets="CompileSpirvShaders"
             Properties="Configuration=$(Configuration);SpirvRegistry=tests;SpirvDomain=vanillagraphicsexpanded;SpirvAssetsRoot=$(TestShaderInputs);SpirvArtifactsDir=$(TestShaderArtifacts)" />
    <ItemGroup>
      <_ClipFixtureBinary Include="$(TestShaderArtifacts)\vanillagraphicsexpanded\shaders\tests\clipdistance\*.spv" />
      <EmbeddedResource Include="@(_ClipFixtureBinary)">
        <LogicalName>VanillaGraphicsExpanded.Tests.Fixtures.ClipDistance.%(_ClipFixtureBinary.Filename)%(_ClipFixtureBinary.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
    <Error Condition="!Exists('$(TestShaderArtifacts)\build-receipt.json')" Text="Missing successful test shader build receipt." />
  </Target>

  <!-- Copy shader assets to test output directory for GPU tests -->
  <ItemGroup>
    <Content Include="Fixtures\Shaders\assets\vanillagraphicsexpanded\**\*" Link="assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\schemas\pbr_material_definitions.schema.json" Link="schemas\pbr_material_definitions.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\VanillaGraphicsExpanded\assets\vanillagraphicsexpanded\config\configlib-patches.json">
      <Link>assets\config\configlib-patches.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\VanillaGraphicsExpanded\assets\vanillagraphicsexpanded\shaders\**\*">
      <Link>assets\shaders\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="..\VanillaGraphicsExpanded\assets\vanillagraphicsexpanded\shaderincludes\**\*">
      <Link>assets\shaderincludes\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Tests exercise the compiled assets. Disabling their producer must fail rather than reuse old binaries. -->
  <Target Name="RequireTestSpirvBuild" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(EnableSpirv)' != 'true'" Text="GPU tests require EnableSpirv=true. Build shader assets before running tests." />
  </Target>

  <!-- Enumerate after project references build, so a clean build includes newly generated binaries. -->
  <Target Name="CopyTestSpirvAssets" AfterTargets="Build">
    <ItemGroup>
      <_TestSpirvFiles Include="$(TestShaderArtifacts)\vanillagraphicsexpanded\shaders\**\*.spv;$(TestShaderArtifacts)\vanillagraphicsexpanded\shaders\**\spirv-digests.json" />
      <_CurrentTestSpirv Include="@(_TestSpirvFiles->'$(TargetDir)assets\shaders\%(RecursiveDir)%(Filename)%(Extension)')" />
      <_ObsoleteTestSpirv Include="$(TargetDir)assets\shaders\**\*.spv" Exclude="@(_CurrentTestSpirv)" />
      <_RequiredTestSpirv Include="..\VanillaGraphicsExpanded\assets\vanillagraphicsexpanded\shaders\*.csh" />
    </ItemGroup>
    <Error Condition="!Exists('$(TestShaderArtifacts)\vanillagraphicsexpanded\shaders\%(_RequiredTestSpirv.Filename)%(_RequiredTestSpirv.Extension).spv')"
           Text="Missing compiled test shader: %(_RequiredTestSpirv.Filename)%(_RequiredTestSpirv.Extension).spv" />
    <Delete Files="@(_ObsoleteTestSpirv)" />
    <Copy SourceFiles="@(_TestSpirvFiles)" DestinationFiles="@(_TestSpirvFiles->'$(TargetDir)assets\shaders\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
