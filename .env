# Local environment configuration for VanillaGraphicsExpanded
# Copy this file to .env.local and adjust paths for your system

# Path to RenderDoc installation (for graphics debugging)
# Windows example: C:\Program Files\RenderDoc
# Linux example: /usr/share/renderdoc

RENDERDOC_PATH=C:\Program Files\RenderDoc

# Development game data directory: client settings, saves, logs, mods, and mod configuration.
# Use an absolute path. Launch profiles pass this value through --dataPath; log and
# development package commands use it too. VINTAGE_STORY remains the game installation path.
# Keep this separate from your normal game data. The local .env must be loaded into
# the launching process environment; IDEs do not automatically load it for every command.

VGE_DATA_PATH=D:\CODE\VintageStory\VintagestoryAutomation\Data
