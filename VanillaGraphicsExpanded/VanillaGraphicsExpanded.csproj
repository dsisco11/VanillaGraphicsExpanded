<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\Mods\mod</OutputPath>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <UserSecretsId>d27ba35c-e681-4545-ab59-471e15a8b36b</UserSecretsId>
  </PropertyGroup>

  <!-- Expose internal types to test project -->
  <ItemGroup>
    <InternalsVisibleTo Include="VanillaGraphicsExpanded.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(VINTAGE_STORY)/Mods/VSEssentials.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VINTAGE_STORY)/Lib/0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(VINTAGE_STORY)/VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VINTAGE_STORY)/Lib/protobuf-net.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="cairo-sharp">
      <HintPath>$(VINTAGE_STORY)/Lib/cairo-sharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenTK.Graphics">
      <HintPath>$(VINTAGE_STORY)/Lib/OpenTK.Graphics.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenTK.Mathematics">
      <HintPath>$(VINTAGE_STORY)/Lib/OpenTK.Mathematics.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VINTAGE_STORY)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.2.1" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.2" />
    <PackageReference Include="TinyAst" Version="0.11.2" />
    <PackageReference Include="TinyAst.Preprocessor" Version="0.4.3" />
    <PackageReference Include="TinyPreprocessor" Version="0.4.0" />
  </ItemGroup>

<ItemGroup>
  <Content Include="modinfo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
</ItemGroup>

<ItemGroup>
  <Content Include="modicon.png" Condition="Exists('modicon.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
</ItemGroup>

<ItemGroup>
  <Content Include="assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
</ItemGroup>

  <!-- Phase 6: MSBuild-integrated SPIR-V compilation (compute shaders). -->
  <PropertyGroup>
    <!-- Default: enabled for all builds (Debug + Release). -->
    <EnableSpirv Condition="'$(EnableSpirv)' == ''">true</EnableSpirv>

    <SpirvDomain Condition="'$(SpirvDomain)' == ''">vanillagraphicsexpanded</SpirvDomain>
    <SpirvArtifactsDir Condition="'$(SpirvArtifactsDir)' == ''">$(MSBuildProjectDirectory)\artifacts\spirv</SpirvArtifactsDir>
    <SpirvTargetEnv Condition="'$(SpirvTargetEnv)' == ''">opengl4.5</SpirvTargetEnv>
    <SpirvWarningsAsErrors Condition="'$(SpirvWarningsAsErrors)' == ''">false</SpirvWarningsAsErrors>

    <SpirvWarningsAsErrorsArg Condition="'$(SpirvWarningsAsErrors)' == 'true'">--warningsAsErrors</SpirvWarningsAsErrorsArg>
    <SpirvWarningsAsErrorsArg Condition="'$(SpirvWarningsAsErrors)' != 'true'"></SpirvWarningsAsErrorsArg>

    <!-- Solution root (contains .config/dotnet-tools.json and ShaderBuildTool). -->
    <VgeSolutionRoot>$(MSBuildProjectDirectory)\..</VgeSolutionRoot>
    <SpirvBuildToolProject>$(VgeSolutionRoot)\ShaderBuildTool\ShaderBuildTool.csproj</SpirvBuildToolProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableSpirv)' == 'true' Or '$(EnableSpirv)' == 'True'">
    <VgeComputeShaders Include="assets\$(SpirvDomain)\shaders\**\*.csh" />
    <VgeShaderIncludes Include="assets\$(SpirvDomain)\shaders\includes\**\*.*" />
  </ItemGroup>

  <Target Name="RestoreDotnetShadercTool" Condition="'$(EnableSpirv)' == 'true' Or '$(EnableSpirv)' == 'True'" BeforeTargets="CompileSpirvShaders">
    <Exec WorkingDirectory="$(VgeSolutionRoot)" Command="dotnet tool restore" />
  </Target>

  <Target Name="CompileSpirvShaders"
          Condition="'$(EnableSpirv)' == 'true' Or '$(EnableSpirv)' == 'True'"
          Inputs="@(VgeComputeShaders);@(VgeShaderIncludes)"
          Outputs="@(VgeComputeShaders->'$(SpirvArtifactsDir)\$(SpirvDomain)\shaders\%(Filename)%(Extension).spv')"
          AfterTargets="Build">
    <Exec
      WorkingDirectory="$(VgeSolutionRoot)"
      Command="dotnet run --project &quot;$(SpirvBuildToolProject)&quot; -- --assetsRoot &quot;$(MSBuildProjectDirectory)\\assets&quot; --outputRoot &quot;$(SpirvArtifactsDir)&quot; --domain $(SpirvDomain) --targetEnv $(SpirvTargetEnv) $(SpirvWarningsAsErrorsArg) --workingDir &quot;$(VgeSolutionRoot)&quot;" />
  </Target>

  <Target Name="LogSpirvCompileStatus" AfterTargets="Build">
    <!-- Deterministic status log: prints whether SPIR-V outputs are up-to-date vs shader inputs. -->
    <Exec
      Condition="'$(OS)' == 'Windows_NT' And ('$(EnableSpirv)' == 'true' Or '$(EnableSpirv)' == 'True')"
      ConsoleToMSBuild="true"
      StandardOutputImportance="High"
      StandardErrorImportance="High"
      EchoOff="true"
      Command="pwsh -NoProfile -ExecutionPolicy Bypass -Command &quot;$domain='$(SpirvDomain)'; $assetsRoot=Join-Path '$(MSBuildProjectDirectory)' 'assets'; $inRoot=Join-Path $assetsRoot ($domain + '\\shaders'); $outRoot='$(SpirvArtifactsDir)'; $outDir=Join-Path $outRoot ($domain + '\\shaders'); if(-not (Test-Path $inRoot)) { Write-Host '[SPIR-V] status: no input shaders folder (skipped)'; exit 0 }; $inputs=Get-ChildItem -Path $inRoot -Recurse -File | Where-Object { $_.Extension -ieq '.csh' -or $_.FullName -match '\\includes\\' }; $outs = @(); if(Test-Path $outDir) { $outs = Get-ChildItem -Path $outDir -Recurse -File -Filter '*.spv' }; if($outs.Count -eq 0) { Write-Host ('[SPIR-V] status: missing outputs (would rebuild) outDir=' + $outDir); exit 0 }; $newIn = ($inputs | Sort-Object LastWriteTime -Descending | Select-Object -First 1).LastWriteTime; $newOut = ($outs | Sort-Object LastWriteTime -Descending | Select-Object -First 1).LastWriteTime; if($newIn -gt $newOut) { Write-Host ('[SPIR-V] status: stale (would rebuild) newestIn=' + $newIn + ' newestOut=' + $newOut) } else { Write-Host ('[SPIR-V] status: up-to-date (skipped) newestIn=' + $newIn + ' newestOut=' + $newOut) }&quot;" />

    <Exec
      Condition="'$(OS)' == 'Windows_NT' And ('$(EnableSpirv)' != 'true' And '$(EnableSpirv)' != 'True')"
      ConsoleToMSBuild="true"
      StandardOutputImportance="High"
      EchoOff="true"
      Command="pwsh -NoProfile -ExecutionPolicy Bypass -Command &quot;Write-Host '[SPIR-V] status: disabled (EnableSpirv=$(EnableSpirv))'&quot;" />
  </Target>

  <Target Name="CopySpirvArtifactsToOutputAssets"
          Condition="'$(EnableSpirv)' == 'true' Or '$(EnableSpirv)' == 'True'"
          AfterTargets="CompileSpirvShaders">
    <ItemGroup>
      <_SpirvFiles Include="$(SpirvArtifactsDir)\**\*.spv" />
      <_SpirvOutDirs Include="@(_SpirvFiles->'$(TargetDir)assets\%(RecursiveDir)')" />
    </ItemGroup>

    <MakeDir Directories="@(_SpirvOutDirs)" />

    <Copy
      SourceFiles="@(_SpirvFiles)"
      DestinationFiles="@(_SpirvFiles->'$(TargetDir)assets\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
