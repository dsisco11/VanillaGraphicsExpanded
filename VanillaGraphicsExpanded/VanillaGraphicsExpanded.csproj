<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\Mods\mod</OutputPath>
    <!-- Publish outside the game-scanned mod tree: nested managed DLLs invalidate a mod. -->
    <PublishDir>bin\$(Configuration)\publish\</PublishDir>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <UserSecretsId>d27ba35c-e681-4545-ab59-471e15a8b36b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep the pre-window automation hook outside the mod loader's search tree. -->
    <ProjectReference Include="../tools/Automation/StartupHook/Automation.StartupHook.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- Expose internal types to test project -->
  <ItemGroup>
    <InternalsVisibleTo Include="VanillaGraphicsExpanded.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(VINTAGE_STORY)/Mods/VSEssentials.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VINTAGE_STORY)/Lib/0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(VINTAGE_STORY)/VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VINTAGE_STORY)/Lib/protobuf-net.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="cairo-sharp">
      <HintPath>$(VINTAGE_STORY)/Lib/cairo-sharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenTK.Graphics">
      <HintPath>$(VINTAGE_STORY)/Lib/OpenTK.Graphics.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenTK.Mathematics">
      <HintPath>$(VINTAGE_STORY)/Lib/OpenTK.Mathematics.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VINTAGE_STORY)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.2.1" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.2" />
    <PackageReference Include="TinyAst" Version="0.11.2" />
    <PackageReference Include="TinyAst.Preprocessor" Version="0.4.3" />
    <PackageReference Include="TinyPreprocessor" Version="0.4.0" />
  </ItemGroup>

<ItemGroup>
  <Content Include="modinfo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
</ItemGroup>

<ItemGroup>
  <Content Include="modicon.png" Condition="Exists('modicon.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
</ItemGroup>

<ItemGroup>
  <Content Include="assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
</ItemGroup>

  <!-- MSBuild-integrated SPIR-V compilation for every owned shader stage. -->
  <PropertyGroup>
    <!-- Default: enabled for all builds (Debug + Release). -->
    <EnableSpirv Condition="'$(EnableSpirv)' == ''">true</EnableSpirv>

    <SpirvDomain Condition="'$(SpirvDomain)' == ''">vanillagraphicsexpanded</SpirvDomain>
    <SpirvArtifactsDir Condition="'$(SpirvArtifactsDir)' == ''">$(MSBuildProjectDirectory)\artifacts\spirv</SpirvArtifactsDir>
    <SpirvTargetEnv Condition="'$(SpirvTargetEnv)' == ''">opengl4.5</SpirvTargetEnv>
    <SpirvWarningsAsErrors Condition="'$(SpirvWarningsAsErrors)' == ''">false</SpirvWarningsAsErrors>

    <SpirvWarningsAsErrorsArg Condition="'$(SpirvWarningsAsErrors)' == 'true'">--warningsAsErrors</SpirvWarningsAsErrorsArg>
    <SpirvWarningsAsErrorsArg Condition="'$(SpirvWarningsAsErrors)' != 'true'"></SpirvWarningsAsErrorsArg>
  </PropertyGroup>

  <!-- Build SPIR-V shaders as a separate project so it shows up as its own entry in build output. -->
  <ItemGroup Condition="'$(EnableSpirv)' == 'true' Or '$(EnableSpirv)' == 'True'">
    <ProjectReference Include="..\SpirvBuild\VanillaGraphicsExpanded.SpirvBuild.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="CopySpirvArtifactsToOutputAssets" Condition="'$(EnableSpirv)' == 'true' Or '$(EnableSpirv)' == 'True'" AfterTargets="Build">
    <ItemGroup>
      <_SpirvFiles Include="$(SpirvArtifactsDir)\**\*.spv" />
      <_SpirvOutDirs Include="@(_SpirvFiles->'$(TargetDir)assets\%(RecursiveDir)')" />
    </ItemGroup>

    <MakeDir Directories="@(_SpirvOutDirs)" />

    <Copy SourceFiles="@(_SpirvFiles)" DestinationFiles="@(_SpirvFiles->'$(TargetDir)assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="../ShaderContractGenerator/ShaderContractGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
