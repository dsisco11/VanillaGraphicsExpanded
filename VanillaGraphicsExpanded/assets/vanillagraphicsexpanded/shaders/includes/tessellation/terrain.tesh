// Runtime terrain stage: interface and engine prefix are supplied by the shader patch pipeline.
#if VGE_ENABLE_TESSELLATION
@import "./terrain_displacement.glsl"
patch in float vge_patchAmplitude;
patch in vec4 vge_patchRect;
#if !VGE_TESS_SHADOW
uniform int vge_displacementReactive;
#endif
layout(triangles, fractional_odd_spacing, ccw) in;
void main() {
    gl_Position = gl_in[0].gl_Position * gl_TessCoord.x
        + gl_in[1].gl_Position * gl_TessCoord.y + gl_in[2].gl_Position * gl_TessCoord.z;
    #if defined(VGE_TESS_HAS_vge_surfaceDisplaced) && !VGE_TESS_SHADOW
    // Invalidate previous geometry even when the current map is missing, neutral or
    // fully faded. Current displacement cannot describe what was visible last frame.
    vge_surfaceDisplaced = float(vge_displacementReactive * vge_displacementEnabled);
    #endif
    if (vge_patchAmplitude > 0.0) {
        vge_uvBase = vge_patchRect.xy;
        vge_uvExtent = vge_patchRect.zw;
        vec3 basePosition = worldPos.xyz;
        vec3 e1 = tc_worldPos[1].xyz - tc_worldPos[0].xyz;
        vec3 e2 = tc_worldPos[2].xyz - tc_worldPos[0].xyz;
        vec2 t1 = tc_uv[1] - tc_uv[0];
        vec2 t2 = tc_uv[2] - tc_uv[0];
        float determinant = t1.x * t2.y - t1.y * t2.x;
        // Use the consistent unperturbed face normal, never the baked normal map. Taking
        // a separate triangle cross product here could separate the internal diagonal
        // when the engine's global vertex warp makes the original quad non-planar.
        vec3 faceNormal = normal;
        if (abs(determinant) > 0.00000001 && dot(faceNormal, faceNormal) > 0.00000001
            && VgeFinite(faceNormal) && VgeFinite(basePosition)) {
            faceNormal = normalize(faceNormal);
            if (dot(faceNormal, normal) < 0.0) faceNormal = -faceNormal;
            vec3 tangentU = (e1 * t2.y - e2 * t1.y) / determinant;
            vec3 tangentV = (e2 * t1.x - e1 * t2.x) / determinant;
            float offset = VgeHeight(uv, vge_uvBase, vge_uvExtent, vge_patchAmplitude, basePosition);
            vec2 delta = 1.0 / vec2(textureSize(vge_normalDepthTex, 0));
            float du = (VgeHeight(uv + vec2(delta.x, 0), vge_uvBase, vge_uvExtent, vge_patchAmplitude, basePosition + tangentU * delta.x)
                - VgeHeight(uv - vec2(delta.x, 0), vge_uvBase, vge_uvExtent, vge_patchAmplitude, basePosition - tangentU * delta.x)) / (2.0 * delta.x);
            float dv = (VgeHeight(uv + vec2(0, delta.y), vge_uvBase, vge_uvExtent, vge_patchAmplitude, basePosition + tangentV * delta.y)
                - VgeHeight(uv - vec2(0, delta.y), vge_uvBase, vge_uvExtent, vge_patchAmplitude, basePosition - tangentV * delta.y)) / (2.0 * delta.y);
            vec3 displacedNormal = cross(tangentU + faceNormal * du, tangentV + faceNormal * dv);
            if ((du != 0.0 || dv != 0.0) && VgeFinite(displacedNormal) && dot(displacedNormal, displacedNormal) > 0.00000001) {
                normal = normalize(displacedNormal);
                if (dot(normal, faceNormal) < 0.0) normal = -normal;
            }
            // Retain the engine's interpolated clip position, including vertex bias.
            // Add only the displacement delta; neutral and pinned edges stay identical.
            if (offset != 0.0) {
                vec3 displacement = faceNormal * offset;
                worldPos.xyz = basePosition + displacement;
            #if VGE_TESS_SHADOW
                gl_Position += mvpMatrix * vec4(displacement, 0.0);
            #else
                // Transform a direction once instead of projecting both full positions.
                float originalDepth = gl_Position.z;
                vec4 cameraDelta = modelViewMatrix * vec4(displacement, 0.0);
                gl_Position += vgeFrame.projectionMatrix * cameraDelta;
            #if defined(VGE_TESS_HAS_shadowCoordsFar) || defined(VGE_TESS_HAS_shadowCoordsNear)
                calcShadowMapCoords(modelViewMatrix, worldPos);
            #endif
            #if VGE_TESS_DEPTH_BIAS
                int zOffset = (renderFlags & (7 << 8)) >> 8;
                float originalBias = originalDepth > -1.0 ? 1.0 / ((originalDepth + 3.0) * 0.05) : 0.0;
                float displacedBias = gl_Position.z > -1.0 ? 1.0 / ((gl_Position.z + 3.0) * 0.05) : 0.0;
                gl_Position.w += float(zOffset) * 0.00025 * (displacedBias - originalBias);
            #endif
            #if defined(VGE_TESS_HAS_camPos)
                camPos += cameraDelta;
            #endif
            #if defined(VGE_TESS_HAS_fragPosition)
                fragPosition += cameraDelta;
            #endif
            #if defined(VGE_TESS_HAS_vertexPosition)
                vertexPosition += displacement;
            #endif
            #endif
            }
            #if defined(VGE_TESS_HAS_gnormal) && !VGE_TESS_SHADOW
            gnormal.xyz = mat3(modelViewMatrix) * normal;
            #endif
        }
    }
}
#endif
