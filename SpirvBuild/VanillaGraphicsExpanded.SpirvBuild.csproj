<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>

    <!-- Default: enabled for all builds unless explicitly disabled. -->
    <EnableSpirv Condition="'$(EnableSpirv)' == ''">true</EnableSpirv>

    <SpirvDomain Condition="'$(SpirvDomain)' == ''">vanillagraphicsexpanded</SpirvDomain>
    <SpirvTargetEnv Condition="'$(SpirvTargetEnv)' == ''">opengl4.5</SpirvTargetEnv>
    <SpirvWarningsAsErrors Condition="'$(SpirvWarningsAsErrors)' == ''">false</SpirvWarningsAsErrors>
    <!-- Empty uses the tool's bounded CPU-based default; 1 retains serial compilation. -->
    <SpirvConcurrencyArg Condition="'$(SpirvConcurrency)' != ''">--concurrency $(SpirvConcurrency)</SpirvConcurrencyArg>
    <SpirvVerifyContentsArg Condition="'$(SpirvVerifyContents)' == 'true'">--verifyContents</SpirvVerifyContentsArg>

    <SpirvWarningsAsErrorsArg Condition="'$(SpirvWarningsAsErrors)' == 'true' Or '$(SpirvWarningsAsErrors)' == 'True'">--warningsAsErrors</SpirvWarningsAsErrorsArg>
    <SpirvWarningsAsErrorsArg Condition="'$(SpirvWarningsAsErrors)' != 'true' And '$(SpirvWarningsAsErrors)' != 'True'"></SpirvWarningsAsErrorsArg>

    <!-- Repo layout assumptions -->
    <VgeSolutionRoot>$(MSBuildThisFileDirectory)..</VgeSolutionRoot>
    <VgeModProjectDir>$(MSBuildThisFileDirectory)..\VanillaGraphicsExpanded</VgeModProjectDir>

    <!-- Keep paths short enough for MSBuild copy tasks on Windows, and isolate build configurations. -->
    <SpirvArtifactsDir Condition="'$(SpirvArtifactsDir)' == ''">$(VgeSolutionRoot)\artifacts\spirv\$(Configuration)</SpirvArtifactsDir>

    <SpirvBuildToolProject>$(VgeSolutionRoot)\ShaderBuildTool\ShaderBuildTool.csproj</SpirvBuildToolProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShaderBuildTool\ShaderBuildTool.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="RestoreDotnetShadercTool"
          Condition="'$(EnableSpirv)' == 'true' Or '$(EnableSpirv)' == 'True'"
          BeforeTargets="CompileSpirvShaders">
    <Message Importance="high" Text="[SPIR-V] Restoring shader compiler tool..." />
    <Exec WorkingDirectory="$(VgeSolutionRoot)" Command="dotnet tool restore" StandardOutputImportance="High" />
  </Target>

  <Target Name="CompileSpirvShaders"
          Condition="'$(EnableSpirv)' == 'true' Or '$(EnableSpirv)' == 'True'"
          AfterTargets="Build">
    <!-- Resolve the executable with the same inherited output properties as its project build. -->
    <MSBuild Projects="$(SpirvBuildToolProject)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_BuiltShaderTool" />
    </MSBuild>
    <Exec
      WorkingDirectory="$(VgeSolutionRoot)"
      StandardOutputImportance="High"
      Command="dotnet &quot;@(_BuiltShaderTool)&quot; --incremental $(SpirvConcurrencyArg) $(SpirvVerifyContentsArg) --assetsRoot &quot;$(VgeModProjectDir)\assets&quot; --outputRoot &quot;$(SpirvArtifactsDir)&quot; --domain $(SpirvDomain) --targetEnv $(SpirvTargetEnv) $(SpirvWarningsAsErrorsArg) --workingDir &quot;$(VgeSolutionRoot)&quot;" />
  </Target>

</Project>
