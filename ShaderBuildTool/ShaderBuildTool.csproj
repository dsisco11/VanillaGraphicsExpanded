<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TinyAst" Version="0.11.3" />
    <PackageReference Include="TinyAst.Preprocessor" Version="0.4.3" />
    <PackageReference Include="TinyPreprocessor" Version="0.4.0" />
    <PackageReference Include="Silk.NET.SPIRV.Cross" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\VanillaGraphicsExpanded\Rendering\Spirv\ShaderBinaryDigest.cs" Link="Spirv\ShaderBinaryDigest.cs" />
    <Compile Include="..\VanillaGraphicsExpanded\Rendering\Spirv\PackagedShaderInterface.cs" Link="Spirv\PackagedShaderInterface.cs" />
    <Compile Include="..\VanillaGraphicsExpanded\Rendering\Spirv\PackagedInterfaceValidation.cs" Link="Spirv\PackagedInterfaceValidation.cs" />
    <!-- Reuse VGE's existing preprocessor helpers (they are engine-agnostic). -->
    <Compile Include="..\VanillaGraphicsExpanded\SourceCodeMutator\GlslSchema.cs" Link="SourceCodeMutator\GlslSchema.cs" />
    <Compile Include="..\VanillaGraphicsExpanded\SourceCodeMutator\GlInterface*.cs;..\VanillaGraphicsExpanded\SourceCodeMutator\GlStageIoNode.cs;..\VanillaGraphicsExpanded\SourceCodeMutator\GlLayoutNode.cs" Link="SourceCodeMutator\%(Filename)%(Extension)" />
    <Compile Include="..\VanillaGraphicsExpanded\PBR\PbrTerrainColorPatches.cs" Link="TestFixtures\PbrTerrainColorPatches.cs" />
    <Compile Include="..\VanillaGraphicsExpanded\SourceCodeMutator\ShaderSyntaxTreePreprocessor.cs" Link="SourceCodeMutator\ShaderSyntaxTreePreprocessor.cs" />
    <Compile Include="..\VanillaGraphicsExpanded\SourceCodeMutator\LineDirectiveInjector.cs" Link="SourceCodeMutator\LineDirectiveInjector.cs" />
    <Compile Include="..\VanillaGraphicsExpanded\SourceCodeMutator\SourceCodeImportsProcessor.cs" Link="SourceCodeMutator\SourceCodeImportsProcessor.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ShaderBuildModel/ShaderBuildModel.csproj" />
    <ProjectReference Include="../ShaderBuildCatalog/ShaderBuildCatalog.csproj" />
  </ItemGroup>
</Project>
