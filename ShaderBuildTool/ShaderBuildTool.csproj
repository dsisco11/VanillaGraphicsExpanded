<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
    <ShaderContractsOffline>true</ShaderContractsOffline>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TinyAst" Version="0.11.2" />
    <PackageReference Include="TinyAst.Preprocessor" Version="0.4.3" />
    <PackageReference Include="TinyPreprocessor" Version="0.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\VanillaGraphicsExpanded\Rendering\Contracts\*.cs;..\VanillaGraphicsExpanded\Rendering\GpuBindingRegistry.cs" Link="Contracts\%(Filename)%(Extension)" />
    <!-- Reuse VGE's existing preprocessor helpers (they are engine-agnostic). -->
    <Compile Include="..\VanillaGraphicsExpanded\SourceCodeMutator\GlslSchema.cs" Link="SourceCodeMutator\GlslSchema.cs" />
    <Compile Include="..\VanillaGraphicsExpanded\SourceCodeMutator\GlInterface*.cs;..\VanillaGraphicsExpanded\SourceCodeMutator\GlStageIoNode.cs;..\VanillaGraphicsExpanded\SourceCodeMutator\GlLayoutNode.cs" Link="SourceCodeMutator\%(Filename)%(Extension)" />
    <Compile Include="..\VanillaGraphicsExpanded\SourceCodeMutator\ShaderSyntaxTreePreprocessor.cs" Link="SourceCodeMutator\ShaderSyntaxTreePreprocessor.cs" />
    <Compile Include="..\VanillaGraphicsExpanded\SourceCodeMutator\LineDirectiveInjector.cs" Link="SourceCodeMutator\LineDirectiveInjector.cs" />
    <Compile Include="..\VanillaGraphicsExpanded\SourceCodeMutator\SourceCodeImportsProcessor.cs" Link="SourceCodeMutator\SourceCodeImportsProcessor.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ShaderContractGenerator/ShaderContractGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <CompilerVisibleProperty Include="ShaderContractsOffline" />
    <!-- Read ordinary shader classes as semantic inputs without compiling their engine-dependent implementation. -->
    <AdditionalFiles Include="../VanillaGraphicsExpanded/**/*.cs" Exclude="../VanillaGraphicsExpanded/bin/**;../VanillaGraphicsExpanded/obj/**;../VanillaGraphicsExpanded/obj2/**" />
  </ItemGroup>
</Project>

