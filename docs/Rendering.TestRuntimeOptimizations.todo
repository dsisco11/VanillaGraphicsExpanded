        (.001, .1, 0, day); (.001, 1, .1, horizon); (.001, 8, 1, night);
        (2, .1, .1, horizon); (2, 1, 1, night); (2, 8, 0, day);
        (25, .1, 1, night); (25, 1, 0, day); (25, 8, .1, horizon);
        (99, .1, 0, day); (99, 1, .1, night); (99, 8, 1, horizon).
